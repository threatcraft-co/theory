# THEORY — API Key Configuration
# Copy this file to .env and fill in your keys.
# .env is gitignored and must never be committed.


# =============================================================================
# LLM PROVIDER  (for vendor intel synthesis + dossier overviews)
# =============================================================================
# Either set an explicit provider, or leave blank to auto-detect.
# Resolution order when THEORY_LLM_PROVIDER is unset: Claude → OpenAI → Ollama
# Values: claude | openai | ollama
THEORY_LLM_PROVIDER=

# Anthropic Claude  —  https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI  —  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama (local, fully offline LLM)
# Default host and model are below; uncomment to override.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2


# =============================================================================
# CORE THREAT INTEL SOURCES
# =============================================================================

# AlienVault OTX  —  free registration at https://otx.alienvault.com/accounts/register
OTX_API_KEY=

# MITRE ATT&CK  —  no key required (local STIX bundle)
# Malpedia       —  no key required (public API)
# SigmaHQ        —  no key required (local git clone)
# YARA Rules     —  no key required (local git clone)
# MISP Galaxy    —  no key required (public API)
# CIRCL MISP     —  no key required (public API)
# CISA KEV       —  no key required (public catalog)


# =============================================================================
# ABUSE.CH ECOSYSTEM
# =============================================================================
# One free key covers ThreatFox, MalwareBazaar, and URLhaus.
# Register at https://auth.abuse.ch/
#
# As of late 2026, abuse.ch requires this Auth-Key on EVERY request to
# ThreatFox, MalwareBazaar, and URLhaus (previously ThreatFox was
# keyless). Without it, all three return HTTP 401 Unauthorized.
ABUSECH_API_KEY=


# =============================================================================
# IOC ENRICHMENT  (post-processors that annotate existing IP indicators)
# =============================================================================

# GreyNoise Community  —  distinguishes targeted activity from internet noise
#   Free tier: 50 lookups/week (requires non-free email to register)
#   https://www.greynoise.io/plans
GREYNOISE_API_KEY=

# AbuseIPDB  —  community IP reputation scoring
#   Free tier: 1,000 checks/day
#   https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Shodan InternetDB  —  open ports, hostnames, CPEs, known CVEs on an IP
#   No key required, no auth, no published rate limit. Free by design —
#   this is NOT the paid Shodan search API (see pyproject.toml's
#   [internet-scan] extra for that, separately, if it's ever implemented).
#   https://internetdb.shodan.io/

# urlscan.io  —  public scan history for domains/URLs
#   No key required for the search endpoint used here. An optional key
#   only raises the rate limit; THEORY never submits anything for scanning.
#   https://urlscan.io/user/signup
URLSCAN_API_KEY=


# =============================================================================
# VULNERABILITY INTELLIGENCE
# =============================================================================

# VulDB  —  actor-CVE correlation and exploit intelligence
#   Free tier: starts at 50 API credits/day (CTI queries cost 5-10 each)
#   https://vuldb.com/?register
VULDB_API_KEY=

# NIST NVD  —  optional, raises rate limit from 5 to 50 req/30s
#   https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=


# =============================================================================
# NOT IMPLEMENTED  (installable but unwired — pip install -e ".[internet-scan]")
# =============================================================================
# The PAID Shodan and Censys APIs have an installable dependency group in
# pyproject.toml but no collector — not on a committed roadmap. VirusTotal
# was considered and deliberately skipped in favor of urlscan.io above,
# which covers similar ground without requiring a signup. Do not set these;
# nothing in THEORY reads them.
#   SHODAN_API_KEY=
#   CENSYS_API_KEY=
#   CRIMINALIP_API_KEY=
#   VIRUSTOTAL_API_KEY=


# =============================================================================
# OPTIONAL
# =============================================================================

# GitHub Personal Access Token  —  optional, helps with git clone rate limits
# for SigmaHQ and YARA Rules repos. Not required for normal usage; only
# useful if you hit GitHub's unauthenticated clone limits or are behind
# a corporate proxy that requires auth.
#   https://github.com/settings/tokens
#   GITHUB_TOKEN=


# =============================================================================
# NO KEYS NEEDED — local-only v2.0 features
# =============================================================================
# These need no configuration at all; mentioned here only so you know they
# exist and that nothing above is required to use them.
#   theory --ioc / --technique / --attack-type / --cve   cross-run graph queries
#   theory ask "<question>"                                answers from local data only
#   theory diff / --watch                                  change tracking over time
#   theory --init-personal                                 your own gitignored research notes
# `theory ask` additionally needs one of the LLM providers configured above —
# it reasons over local data, but still needs a model to do the reasoning.
